---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section id="about" class="min-h-[80vh] flex flex-col justify-center items-center px-6 relative">
		<!-- avatar -->
        
        <h1 class="mt-8 text-2xl md:text-4xl font-extrabold tracking-tight text-center">
            My domains
        </h1>
        <p class="mt-4 text-base md:text-lg text-gray-300 max-w-3xl">
            Dear stranger,
            <br>
            The domain you tried to access is in my possession.
            <br>
            Some of these domains are for sale. If you're interested, contact me below.
            <br>
            Feel free to check my website in the meantime.
            <br>
        </p>

		<!-- social -->
        <div class="mt-8 flex items-center justify-center gap-4 md:gap-6">
            <!-- email -->
            <a href="mailto:domains@andrecadete.com" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-800 bg-gray-900/50 text-sm md:text-base text-gray-300 hover:text-white hover:border-indigo-500/50 hover:bg-indigo-500/10 transition-all duration-300 shadow-sm hover:shadow-[0_0_15px_rgba(79,70,229,0.2)]">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <span>domains@andrecadete.com</span>
            </a>
        </div>

		
    </section>
</Layout>
